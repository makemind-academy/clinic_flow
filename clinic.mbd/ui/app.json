{
  "type": "application",
  "title": "Clinic flow",
  "version": "1.0.0",
  "initialRoute": "/",
  "routes": {
    "/": "ui://pages/flow",
    "/readings": "ui://pages/readings"
  },
  "theme": {
    "mode": "light",
    "color": {
      "primary": "#0e7490",
      "onPrimary": "#ffffff",
      "primaryContainer": "#d8eef4",
      "onPrimaryContainer": "#053644",
      "surface": "#ffffff",
      "onSurface": "#101a1e",
      "surfaceContainerHighest": "#f2f6f8",
      "onSurfaceVariant": "#7b8a91",
      "outline": "#e0e8ec",
      "outlineVariant": "#e0e8ec",
      "error": "#b3261e",
      "onError": "#ffffff",
      "warning": "#a4620a",
      "onWarning": "#ffffff",
      "inverseSurface": "#101a1e",
      "inverseOnSurface": "#ffffff"
    },
    "spacing": {
      "xxs": 2,
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "2xl": 48
    },
    "shape": {
      "none": 0,
      "extraSmall": 4,
      "small": 8,
      "medium": 12,
      "large": 16,
      "extraLarge": 28,
      "full": 999
    },
    "fonts": {
      "JetBrainsMono": {
        "source": "asset",
        "family": "JetBrainsMono"
      }
    }
  },
  "state": {
    "initial": {
      "steps": [],
      "stepCount": 0,
      "doneCount": 0,
      "next": "",
      "nextNeeds": "",
      "readings": [],
      "toolRule": "",
      "notice": ""
    }
  },
  "onInit": {
    "type": "tool",
    "tool": "flow.state",
    "params": {}
  }
}
